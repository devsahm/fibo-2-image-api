# Copy to .env and fill in.

# Hugging Face token (the model is gated — accept the terms on the model page first)
# Create one at https://huggingface.co/settings/tokens (Read access is enough)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# Gemini key used by bria-vgl to turn short prompts into structured blueprints
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Your own secret. Clients must send it as the X-API-Key header. Leave empty to disable auth (local only!)
API_KEY=change-me-to-a-long-random-string

# 1 = keep parts of the model in RAM and move them to the GPU on demand.
# Needed on 24 GB cards; slower. Leave 0 on 40 GB+ cards.
CPU_OFFLOAD=0

# 1 = use FlashAttention-3 (H100 GPUs only, faster)
FLASH_ATTENTION_3=0

# How many images can be painted on the GPU at the same time. Keep 1 unless you have lots of VRAM.
MAX_CONCURRENT_JOBS=1

# Quality defaults (model card recommends 50 steps, guidance 5.0)
DEFAULT_STEPS=50
DEFAULT_GUIDANCE=5.0
MAX_UPLOAD_MB=15
